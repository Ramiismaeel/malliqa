# Copy to .env.local for local development, and set the same variables in
# Vercel → Project → Settings → Environment Variables.

# Required for the AI assistant. Server-side only — never add NEXT_PUBLIC_ here.
GEMINI_API_KEY=

# Optional. Model used by /api/ai/suggest (default: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. When set, /api/ai/suggest requires the same value in the
# `x-app-token` header. Enter it once in the app: إعدادات → رمز الوصول.
APP_ACCESS_TOKEN=

# Optional. Comma-separated origins allowed to call the AI route cross-origin
# (future Capacitor build), e.g. https://localhost,capacitor://localhost
ALLOWED_ORIGINS=

# Optional, client-side. Base URL of the deployment that serves /api/ai/*.
# Leave empty on Vercel (same origin). Set it for a static-export / Capacitor build.
NEXT_PUBLIC_AI_BASE_URL=
